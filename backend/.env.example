# Optional defaults are shown below. Existing process variables take precedence.
PORT=3000
NODE_ENV=development
# Comma-separated HTTP(S) origins; wildcards and URL paths are not accepted.
CORS_ORIGIN=http://localhost:5173
# AI backend origin only; the client appends the internal API path.
AI_SERVICE_URL=http://127.0.0.1:8001
# Entire upstream request, including response-body reading (1–60000 ms).
AI_SERVICE_TIMEOUT_MS=5000
# Required shared secret (>= 32 chars) for Node-to-FastAPI HS256 service tokens.
# Must match ai-backend AI_INTERNAL_AUTH_SECRET; never commit a real secret.
AI_INTERNAL_AUTH_SECRET=replace-with-shared-32-plus-char-internal-auth-secret
# Short-lived internal service token lifetime in seconds (1–300; default 60).
AI_INTERNAL_AUTH_TOKEN_TTL_SECONDS=60
AI_INTERNAL_AUTH_ISSUER=onusai-backend
AI_INTERNAL_AUTH_AUDIENCE=onusai-ai-backend
# Required. Replace the placeholder with your local PostgreSQL password.
# Docker exposes PostgreSQL on host port 5433 (container port 5432).
# Percent-encode special characters in credentials; never commit a real URL.
DATABASE_URL=postgresql://onusai:replace-with-your-local-password@127.0.0.1:5433/onusai
# For cloud PostgreSQL, use the provider URL with TLS, e.g. ?sslmode=verify-full.
# For a private CA, configure the provider CA with sslrootcert in the URL.
# Positive integer milliseconds, from 1 through 60000.
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=5000
# Staff session lifetime in milliseconds (1000–2592000000; default 8 hours).
AUTH_SESSION_TTL_MS=28800000
# Login brute-force protection: max failures (1–100), window ms, lockout ms (1000–86400000).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LOCKOUT_MS=900000
# Default conversation retention window in days (1–3650).
CONVERSATION_RETENTION_DAYS=90


