# Optional overrides. Environment variables take priority over ai-backend/.env.
AI_APP_NAME="OnusSync AI Service"
AI_LOG_LEVEL=INFO
# Required shared secret (>= 32 chars) for Node-to-FastAPI HS256 service tokens.
# Must match backend AI_INTERNAL_AUTH_SECRET; never commit a real secret.
AI_INTERNAL_AUTH_SECRET=replace-with-shared-32-plus-char-internal-auth-secret
AI_INTERNAL_AUTH_ISSUER=onussync-backend
AI_INTERNAL_AUTH_AUDIENCE=onussync-ai-backend
AI_INTERNAL_AUTH_MAX_TTL_SECONDS=300
AI_INTERNAL_AUTH_CLOCK_SKEW_SECONDS=0
# Maximum internal request body size in bytes (1024–1048576; default 256 KB).
AI_INTERNAL_MAX_REQUEST_BYTES=262144
# Maximum accepted remaining request deadline in milliseconds (100–300000).
AI_INTERNAL_MAX_DEADLINE_MS=60000
# Generation mode: "gemini" (live SDK, requires AI_GEMINI_API_KEY) or "mock" (offline deterministic).
AI_GENERATION_MODE=gemini
# Required when AI_GENERATION_MODE=gemini; keep server-only in untracked ai-backend/.env.
AI_GEMINI_API_KEY=replace-with-your-gemini-api-key
# Supported free-tier-eligible Gemini model identifier.
AI_GEMINI_MODEL=gemini-2.5-flash-lite
