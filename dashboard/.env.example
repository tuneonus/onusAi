# Leave empty in local development to use Vite's /api proxy (recommended for cookie sessions & CSRF).
# Set to an explicit backend origin (without trailing slash or /api/v1) when hosting separately.
VITE_API_BASE_URL=

# Target backend origin for the Vite development server proxy (/api -> target).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000

